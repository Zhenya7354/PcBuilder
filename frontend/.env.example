# Base URL for the PcBuilder API
# Default local launch (`dotnet run` http profile) uses port 5150:
VITE_API_BASE_URL=http://localhost:5150

# If you run the https profile (https://localhost:7088), either trust the cert:
#   dotnet dev-certs https --trust
# and set:
# VITE_API_BASE_URL=https://localhost:7088
