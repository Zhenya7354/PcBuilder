{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Username=postgres;Password=CHANGE_ME;Database=PcBuilderDb"
  },
  "Jwt": {
    "Key": "CHANGE_ME_USE_DOTNET_USER_SECRETS",
    "Issuer": "https://localhost:7088",
    "Audience": "https://localhost:7088",
    "ExpiresInMinutes": 60
  },
  "Identity": {
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 8,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false
    },
    "Lockout": {
      "DefaultLockoutTimeSpan": 15,
      "MaxFailedAccessAttempts": 5
    },
    "User": {
      "RequireUniqueEmail": true
    }
  },
  "Gemini": {
    "Model": "gemini-3.5-flash",
    "ApiKey": ""
  },
  "ComponentCatalogCache": {
    "AbsoluteExpirationInMinutes": 30,
    "SlidingExpirationInMinutes": 10,
    "SizeLimit": 1024,
    "EntrySize": 1
  },
  "ExchangeRatesCache": {
    "AbsoluteExpirationInHours": 12,
    "EntrySize": 1
  },
  "ExchangeRatesApi": {
    "ApiUrl": "https://api.frankfurter.dev/",
    "BaseCurrency": "USD",
    "TimeoutInSeconds": 30
  }
}
